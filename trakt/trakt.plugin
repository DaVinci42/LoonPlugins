#!name=Trakt Upsell Remover
#!desc=Remove Trakt VIP upsell locally
#!author=DaVinci42
#!icon=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/trakt.png
#!homepage=https://github.com/DaVinci42/LoonPlugins
#!date=2026-10-24
#!version=1.2.0

[Script]
http-response ^https?:\/\/apiz\.trakt\.tv\/users\/settings script-path=https://raw.githubusercontent.com/DaVinci42/LoonPlugins/main/trakt/trakt.js,requires-body=true,tag=Trakt Upsell Remover,enable=true
http-response ^https?:\/\/apiz\.trakt\.tv\/v3\/users\/me\/following\/activities(?:\?|$) script-path=https://raw.githubusercontent.com/DaVinci42/LoonPlugins/main/trakt/trakt.js,requires-body=true,tag=Trakt Following Activity Blocker,enable=true

[MITM]
hostname = apiz.trakt.tv
